---
import { Icon } from "astro-icon/components";
import { formatDate, formatShortDate } from "../../utils/date";
import { withBasePath } from "../../utils/paths";
import { estimateReadTime } from "../../utils/text";
import MetaItem from "../ui/MetaItem.astro";
import TagBadgeList from "../ui/TagBadgeList.astro";
import ViewCollection from "../ui/ViewCollection.astro";
import ViewItem from "../ui/ViewItem.astro";

interface HomeFeedPostItem {
  type: "post";
  id: string;
  title: string;
  href: string;
  publishedAt: Date;
  tags: string[];
  minutesRead: number;
}

interface HomeFeedSeriesItem {
  type: "series";
  id: string;
  title: string;
  href: string;
  publishedAt: Date;
  description?: string;
  count: number;
  latestPostTitle?: string;
}

export type HomeFeedItem = HomeFeedPostItem | HomeFeedSeriesItem;

interface HomeFeedDisplayBase {
  metaIcon: string;
  metaLabel: string;
  /** Compact copy for list rows, where prefixes like "预计阅读" are noise. */
  metaLabelShort: string;
  publishedAtIso: string;
  publishedAtLabel: string;
}

type HomeFeedDisplayItem =
  | (HomeFeedPostItem &
      HomeFeedDisplayBase & {
        description?: undefined;
      })
  | (HomeFeedSeriesItem & HomeFeedDisplayBase);

interface Props {
  items: HomeFeedItem[];
  title?: string;
  description?: string;
  showViewToggle?: boolean;
  defaultView?: "card" | "list";
}

const {
  items,
  title,
  description,
  showViewToggle = true,
  defaultView = "card",
} = Astro.props;

function getPostReadTime(item: HomeFeedPostItem) {
  return estimateReadTime(item.minutesRead);
}

function getDisplayItem(item: HomeFeedItem): HomeFeedDisplayItem {
  const publishedAtIso = item.publishedAt.toISOString();
  const publishedAtLabel = formatDate(item.publishedAt);

  if (item.type === "series") {
    return {
      ...item,
      metaIcon: "material-symbols:layers-outline-rounded",
      metaLabel: `${item.count} 篇文章`,
      metaLabelShort: `${item.count} 篇文章`,
      publishedAtIso,
      publishedAtLabel,
    };
  }

  return {
    ...item,
    metaIcon: "material-symbols:schedule-outline-rounded",
    metaLabel: `预计阅读 ${getPostReadTime(item)}`,
    metaLabelShort: getPostReadTime(item),
    publishedAtIso,
    publishedAtLabel,
  };
}

const displayItems = items.map(getDisplayItem);
---

<ViewCollection
  defaultView={defaultView}
  showViewToggle={showViewToggle}
  title={title}
  description={description}
  viewKey="home-feed"
>
  {displayItems.length === 0 && (
    <div class="surface-card p-6 text-sm leading-7 text-muted-foreground">
      暂无内容。在 <code>src/content/blog</code> 下添加 Markdown
      文件后，首页信息流会自动展示。
    </div>
  )}
  {displayItems.map((item) => (
    <ViewItem href={withBasePath(item.href)} view={defaultView}>
      <Fragment slot="card">
        <h3 class="card-title line-clamp-2 text-strong transition-ui group-hover:text-primary">
          {item.title}
        </h3>

        {item.type === "series" ? (
          <div class="mt-auto space-y-2.5 pt-3">
            {item.latestPostTitle && (
              <div class="container-box px-3 py-2">
                <div class="flex items-center gap-1.5 text-xs font-semibold tracking-widest text-primary uppercase">
                  <Icon
                    name="material-symbols:bookmark-star-outline-rounded"
                    size={14}
                  />
                  最新文章
                </div>
                <p class="mt-1 line-clamp-2 text-sm text-muted-foreground transition-ui group-hover:text-primary">
                  {item.latestPostTitle}
                </p>
              </div>
            )}
            <div class="meta-row">
              <MetaItem
                icon={item.metaIcon}
                as="div"
                class="tabular-nums"
              >
                {item.metaLabel}
              </MetaItem>
              <MetaItem
                as="time"
                datetime={item.publishedAtIso}
                icon="material-symbols:calendar-today-outline-rounded"
                class="tabular-nums"
              >
                {item.publishedAtLabel}
              </MetaItem>
            </div>
          </div>
        ) : (
          <div class="mt-auto space-y-2.5 pt-3">
            <TagBadgeList tags={item.tags} variant="plain" max={3} />
            <div class="meta-row">
              <MetaItem
                as="time"
                datetime={item.publishedAtIso}
                icon="material-symbols:calendar-today-outline-rounded"
                class="tabular-nums"
              >
                {item.publishedAtLabel}
              </MetaItem>
              <MetaItem icon={item.metaIcon}>
                {item.metaLabel}
              </MetaItem>
            </div>
          </div>
        )}
      </Fragment>

      <Fragment slot="list">
        <time
          datetime={item.publishedAtIso}
          class="view-collection-date-col text-sm leading-6 tabular-nums text-muted-foreground"
        >
          {item.publishedAtLabel}
        </time>

        <div class="min-w-0 space-y-1">
          <div
            class="text-base leading-6 font-medium text-strong transition-ui group-hover:text-primary"
          >
            {item.title}
          </div>
          {item.type === "series" ? (
            <>
              {item.latestPostTitle && (
                <div class="line-clamp-1 text-sm text-muted-foreground">
                  最新：
                  <span class="font-medium text-strong transition-ui group-hover:text-primary">
                    {item.latestPostTitle}
                  </span>
                </div>
              )}
              <div class="meta-row">
                <time
                  datetime={item.publishedAtIso}
                  class="view-collection-date-inline tabular-nums"
                >
                  {formatShortDate(item.publishedAt)}
                </time>
                <MetaItem icon={item.metaIcon} class="tabular-nums">
                  {item.metaLabel}
                </MetaItem>
              </div>
            </>
          ) : (
            <div class="meta-row">
              <time
                datetime={item.publishedAtIso}
                class="view-collection-date-inline tabular-nums"
              >
                {formatShortDate(item.publishedAt)}
              </time>
              <MetaItem icon={item.metaIcon}>
                {item.metaLabelShort}
              </MetaItem>
              <TagBadgeList tags={item.tags} variant="plain" />
            </div>
          )}
        </div>
      </Fragment>
    </ViewItem>
  ))}
</ViewCollection>
