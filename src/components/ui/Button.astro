---
import type { HTMLAttributes } from "astro/types";
import { withBasePath } from "../../utils/paths";

// The component renders `<a>` when `href` is set and `<button>` otherwise,
// so native attributes from both elements are accepted.
type NativeAttributes = HTMLAttributes<"a"> & HTMLAttributes<"button">;

export interface Props
  extends Omit<NativeAttributes, "class" | "href" | "type"> {
  variant?: "primary" | "secondary" | "soft" | "ghost" | "borderless";
  size?: "sm" | "md" | "lg";
  shape?: "rect" | "circle";
  segmented?: boolean;
  href?: string;
  class?: string;
  type?: "button" | "submit" | "reset";
  active?: boolean;
}

const {
  variant = "secondary",
  size = "md",
  shape = "rect",
  segmented = false,
  href,
  class: className,
  type = "button",
  active = false,
  ...attrs
} = Astro.props;
const Tag = href ? "a" : "button";
const resolvedHref = href ? withBasePath(href) : undefined;
---

<Tag
  class:list={[
    "inline-flex shrink-0 items-center justify-center gap-2 font-medium transition-ui motion-safe:active:scale-[0.98] disabled:pointer-events-none disabled:opacity-50",
    {
      "rounded-full": shape === "circle",
      "rounded-control": shape === "rect",
      "px-3.5 py-2 text-sm": shape === "rect" && size === "sm",
      "px-4 py-2.5 text-sm": shape === "rect" && size === "md",
      "px-5 py-3 text-base": shape === "rect" && size === "lg",
      "size-9 text-sm": shape === "circle" && size === "sm",
      "size-11 text-base": shape === "circle" && size === "md",
      "size-12 text-lg": shape === "circle" && size === "lg",
      "border border-transparent bg-primary text-primary-foreground hover:bg-primary/90":
        variant === "primary",
      "border border-border bg-card text-strong hover:bg-container-faint":
        variant === "secondary",
      "border border-transparent bg-accent/70 text-primary hover:bg-accent":
        variant === "soft",
      "border border-border/80 bg-transparent text-muted-foreground hover:bg-container-faint hover:text-primary aria-pressed:border-transparent aria-pressed:bg-accent aria-pressed:text-primary":
        variant === "ghost" && !segmented,
      "border border-transparent bg-transparent text-muted-foreground hover:bg-container-faint hover:text-primary":
        variant === "borderless",
      "border border-transparent bg-transparent text-muted-foreground shadow-none hover:bg-container-faint hover:text-primary aria-pressed:border-transparent aria-pressed:bg-(--control-thumb) aria-pressed:text-strong aria-pressed:shadow-(--shadow-card)":
        variant === "ghost" && segmented,
      "border-transparent bg-accent text-primary":
        active && variant !== "primary",
    },
    className,
  ]}
  href={resolvedHref}
  type={href ? undefined : type}
  {...attrs}
>
  <slot />
</Tag>
