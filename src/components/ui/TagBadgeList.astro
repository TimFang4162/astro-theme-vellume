---
import Badge from "./Badge.astro";

interface Props {
  tags: string[];
  class?: string;
  variant?: "badge" | "plain";
  /** Show at most this many tags, collapsing the rest into a muted "+N". */
  max?: number;
}

const { tags, class: className, variant = "badge", max } = Astro.props;
const visibleTags = max ? tags.slice(0, max) : tags;
const overflowCount = tags.length - visibleTags.length;
---

{tags.length > 0 && (
  <div
    class:list={[
      variant === "badge"
        ? "flex flex-wrap gap-2"
        : "flex flex-wrap gap-x-3 gap-y-1 text-sm text-muted-foreground",
      className,
    ]}
  >
    {visibleTags.map((tag) =>
      variant === "badge" ? (
        <Badge size="sm" color="default">
          {tag}
        </Badge>
      ) : (
        <span>#{tag}</span>
      ),
    )}
    {overflowCount > 0 && (
      <span>+{overflowCount}</span>
    )}
  </div>
)}
