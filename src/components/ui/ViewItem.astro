---
// Shared dual-layout wrapper for feed items. The `data-view-item` element and
// the card/list pair are the DOM contract behind the card/list view toggle
// (styled in `src/styles/components.css`); keeping it in one place prevents
// the two layouts from drifting apart.
interface Props {
  href: string;
  view?: "card" | "list";
  /** List-row date column: "full" keeps the long localized date, "compact"
   *  renders the short M-D form (for lists already grouped under a month
   *  heading, where repeating year and month is noise). */
  dateStyle?: "full" | "compact";
}

const { href, view = "card", dateStyle = "full" } = Astro.props;
---

<!-- biome-ignore lint/a11y/useAnchorContent: accessible content renders through the named slots -->
<a
  href={href}
  data-view-item={view}
  class="view-collection-item group block transition-ui"
>
  <div
    class="view-collection-card surface-card surface-card-hover flex h-full flex-col p-4"
  >
    <slot name="card" />
  </div>

  <!-- Inset hover surface: the row tint is a rounded rectangle floating
       inside the container instead of a band bleeding into its border. -->
  <div
    class="view-collection-list list-row-hover mx-2 rounded-inner px-3 py-3.5"
    data-view-list-layout={dateStyle === "compact" ? "dated-compact" : "dated-full"}
  >
    <slot name="list" />
  </div>
</a>
