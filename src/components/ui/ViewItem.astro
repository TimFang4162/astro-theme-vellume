---
// Shared dual-layout wrapper for feed items. The `data-view-item` element and
// the card/list pair are the DOM contract behind the card/list view toggle
// (styled in `src/styles/global.css`); keeping it in one place prevents the
// two layouts from drifting apart.
interface Props {
  href: string;
  view?: "card" | "list";
}

const { href, view = "card" } = Astro.props;
---

<!-- biome-ignore lint/a11y/useAnchorContent: accessible content renders through the named slots -->
<a
  href={href}
  data-view-item={view}
  class="view-collection-item group block transition"
>
  <div
    class="view-collection-card surface-card surface-card-hover flex h-full flex-col p-4"
  >
    <slot name="card" />
  </div>

  <div
    class="view-collection-list list-row-hover px-5 py-4"
    data-view-list-layout="dated"
  >
    <slot name="list" />
  </div>
</a>
