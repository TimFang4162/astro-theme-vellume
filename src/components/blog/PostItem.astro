---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { formatDate, formatMonthDay, formatShortDate } from "../../utils/date";
import { withBasePath } from "../../utils/paths";
import { estimateReadTime, getEntryReadMinutes } from "../../utils/text";
import MetaItem from "../ui/MetaItem.astro";
import TagBadgeList from "../ui/TagBadgeList.astro";
import ViewItem from "../ui/ViewItem.astro";

interface Props {
  post: CollectionEntry<"blog">;
  view?: "card" | "list";
  seriesTitle?: string;
  dateStyle?: "full" | "compact";
}

const { post, view = "card", seriesTitle, dateStyle = "full" } = Astro.props;
const { id, data } = post;
const readTime = estimateReadTime(getEntryReadMinutes(post));
const publishedAtIso = data.publishedAt.toISOString();
const publishedAtLabel = formatDate(data.publishedAt);
const seriesLabel = seriesTitle ?? data.series?.id;
---

<ViewItem href={withBasePath(`/posts/${id}`)} view={view} dateStyle={dateStyle}>
  <Fragment slot="card">
    <h3
      class="card-title line-clamp-2 text-strong transition-ui group-hover:text-primary"
    >
      {data.title}
    </h3>

    <div class="mt-auto space-y-2.5 pt-3">
      <TagBadgeList tags={data.tags} variant="plain" max={3} />
      <div class="meta-row">
        <MetaItem
          as="time"
          datetime={publishedAtIso}
          icon="material-symbols:calendar-today-outline-rounded"
          class="tabular-nums"
        >
          {publishedAtLabel}
        </MetaItem>
        <MetaItem icon="material-symbols:schedule-outline-rounded">
          预计阅读 {readTime}
        </MetaItem>
      </div>
    </div>
  </Fragment>

  <Fragment slot="list">
    <time
      datetime={publishedAtIso}
      class="view-collection-date-col text-sm leading-6 tabular-nums text-muted-foreground"
    >
      {dateStyle === "compact" ? formatMonthDay(data.publishedAt) : publishedAtLabel}
    </time>

    <div class="min-w-0 space-y-1">
      <div
        class="text-base leading-6 font-medium text-strong transition-ui group-hover:text-primary"
      >
        {data.title}
      </div>
      <div class="meta-row">
        <time
          datetime={publishedAtIso}
          class="view-collection-date-inline tabular-nums"
        >
          {dateStyle === "compact"
            ? formatMonthDay(data.publishedAt)
            : formatShortDate(data.publishedAt)}
        </time>
        <MetaItem icon="material-symbols:schedule-outline-rounded">
          {readTime}
        </MetaItem>
        {seriesLabel && (
          <span class="meta-item text-primary">
            <Icon name="material-symbols:layers-outline-rounded" size={14} />
            {seriesLabel}
          </span>
        )}
        <TagBadgeList tags={data.tags} variant="plain" />
      </div>
    </div>
  </Fragment>
</ViewItem>
