---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { formatDate } from "../../utils/date";
import { withBasePath } from "../../utils/paths";
import { estimateReadTime, getEntryReadMinutes } from "../../utils/text";
import Badge from "../ui/Badge.astro";
import MetaItem from "../ui/MetaItem.astro";
import TagBadgeList from "../ui/TagBadgeList.astro";
import ViewItem from "../ui/ViewItem.astro";

interface Props {
  post: CollectionEntry<"blog">;
  view?: "card" | "list";
  seriesTitle?: string;
}

const { post, view = "card", seriesTitle } = Astro.props;
const { id, data } = post;
const readTime = estimateReadTime(getEntryReadMinutes(post));
const publishedAtIso = data.publishedAt.toISOString();
const publishedAtLabel = formatDate(data.publishedAt);
const seriesLabel = seriesTitle ?? data.series?.id;
---

<ViewItem href={withBasePath(`/posts/${id}`)} view={view}>
  <Fragment slot="card">
    <h3 class="card-title text-strong transition-ui group-hover:text-primary">
      {data.title}
    </h3>

    <div class="mt-auto space-y-2.5 pt-3">
      <TagBadgeList tags={data.tags} variant="plain" />
      <div class="meta-row">
        <MetaItem
          as="time"
          datetime={publishedAtIso}
          icon="material-symbols:calendar-today-outline-rounded"
          class="font-mono"
        >
          {publishedAtLabel}
        </MetaItem>
        <MetaItem icon="material-symbols:schedule-outline-rounded">
          预计阅读 {readTime}
        </MetaItem>
      </div>
    </div>
  </Fragment>

  <Fragment slot="list">
    <time
      datetime={publishedAtIso}
      class="text-sm font-mono text-muted-foreground"
    >
      {publishedAtLabel}
    </time>

    <div class="min-w-0 space-y-2">
      <div
        class="text-base font-medium text-strong transition-ui group-hover:text-primary"
      >
        {data.title}
      </div>
      <div class="meta-row">
        <MetaItem icon="material-symbols:schedule-outline-rounded">
          预计阅读 {readTime}
        </MetaItem>
        {seriesLabel && (
          <Badge size="sm" color="primary" class="gap-1.5">
            <Icon
              name="material-symbols:layers-outline-rounded"
              size={14}
            />
            {seriesLabel}
          </Badge>
        )}
        <TagBadgeList tags={data.tags} variant="plain" />
      </div>
    </div>
  </Fragment>
</ViewItem>
