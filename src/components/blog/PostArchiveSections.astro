---
import type { CollectionEntry } from "astro:content";
import { groupPostsByMonth } from "../../lib/blog";
import PostList from "./PostList.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
  headingTag?: "h2" | "h3";
  defaultView?: "card" | "list";
  class?: string;
  viewKey?: string;
}

const {
  posts,
  headingTag = "h2",
  defaultView = "list",
  class: className,
  viewKey = "posts-archive",
} = Astro.props;

const groupedPosts = groupPostsByMonth(posts);
const sortedMonths = Object.keys(groupedPosts).sort().reverse();
const HeadingTag = headingTag;

/** "2026-03" group keys come straight from the grouper; render them as a
 *  localized heading instead of a raw ISO month. */
function formatMonthHeading(month: string) {
  const [year, monthNumber] = month.split("-");
  return `${year} 年 ${Number(monthNumber)} 月`;
}
---

<div class:list={["page-stack", className]}>
  {sortedMonths.length === 0 && (
    <div class="surface-card p-6 text-sm leading-7 text-muted-foreground">
      还没有文章。可在 <code>src/content/blog</code> 中添加 Markdown 内容来生成归档列表。
    </div>
  )}
  {sortedMonths.map((month) => (
    <section class="space-y-4">
      <HeadingTag class:list={["section-title", "flex items-baseline gap-3", "text-strong"]}>
        {formatMonthHeading(month)}
        <span class="text-sm font-normal tabular-nums text-muted-foreground">
          {groupedPosts[month].length} 篇
        </span>
      </HeadingTag>
      <PostList
        posts={groupedPosts[month]}
        defaultView={defaultView}
        viewKey={viewKey}
        dateStyle="compact"
      />
    </section>
  ))}
</div>
