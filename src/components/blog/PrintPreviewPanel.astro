---
import { printProfileOptions } from "../../config/theme-profiles";

/**
 * Print preview configuration panel. Present on article pages but hidden
 * until a preview session starts (from the title-row action menu). The
 * print stylesheet hides the panel itself, so adjustments show on screen
 * and never reach paper. Controls mirror onto root data attributes
 * (data-print / data-print-links / data-print-images / data-print-break)
 * that both the preview and the real print consume.
 */
---

<div
  id="print-preview-panel"
  class="popover-card fixed bottom-6 right-6 z-[95] w-60 p-3"
  data-print-preview-panel
  hidden
>
  <p class="mb-2 text-base font-semibold text-strong">打印预览</p>

  <fieldset class="m-0 border-0 p-0">
    <legend
      class="mb-1 text-xs font-medium uppercase tracking-widest text-muted-foreground"
    >
      打印风格
    </legend>
    <div class="flex flex-col">
      {printProfileOptions.map((option) => (
          <label class="flex cursor-pointer items-center gap-2 rounded-inner px-2 py-1 has-checked:bg-container-faint has-checked:text-primary">
            <input
              type="radio"
              name="pp-style"
              value={option.name}
              class="accent-primary"
              data-pp-style={option.name}
            />
            {option.label}
          </label>
        ))}
    </div>
  </fieldset>

  <fieldset class="mt-3 mb-0 border-0 p-0">
    <legend
      class="mb-1 text-xs font-medium uppercase tracking-widest text-muted-foreground"
    >
      链接
    </legend>
    <div class="flex gap-4">
      <label class="flex cursor-pointer items-center gap-1.5 text-sm">
        <input
          type="radio"
          name="pp-links"
          value="footnote"
          class="accent-primary"
          checked
        >
        展开
      </label>
      <label class="flex cursor-pointer items-center gap-1.5 text-sm">
        <input
          type="radio"
          name="pp-links"
          value="plain"
          class="accent-primary"
        >
        收起
      </label>
    </div>
  </fieldset>

  <fieldset class="mt-3 mb-0 border-0 p-0">
    <legend
      class="mb-1 text-xs font-medium uppercase tracking-widest text-muted-foreground"
    >
      图片
    </legend>
    <div class="flex gap-4">
      <label class="flex cursor-pointer items-center gap-1.5 text-sm">
        <input
          type="radio"
          name="pp-images"
          value="all"
          class="accent-primary"
          checked
        >
        显示
      </label>
      <label class="flex cursor-pointer items-center gap-1.5 text-sm">
        <input
          type="radio"
          name="pp-images"
          value="none"
          class="accent-primary"
        >
        隐藏
      </label>
    </div>
  </fieldset>

  <label
    class="mt-3 flex cursor-pointer items-center gap-2 text-sm has-checked:text-primary"
  >
    <input type="checkbox" name="pp-break" class="accent-primary">
    章节起新页
  </label>

  <div class="mt-3 flex items-center gap-2">
    <button
      type="button"
      class="rounded-control bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground transition-ui hover:bg-primary/90"
      data-pp-print
    >
      开始打印
    </button>
    <button
      type="button"
      class="rounded-control border border-border px-3 py-1.5 text-sm font-medium text-strong transition-ui hover:bg-container-faint"
      data-pp-exit
    >
      退出预览
    </button>
  </div>
</div>

<script>
import "../../scripts/ui/print-preview";
</script>
