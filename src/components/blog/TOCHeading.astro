---
import { Icon } from "astro-icon/components";

export interface TocItem {
  depth: number;
  slug: string;
  text: string;
  subheadings: TocItem[];
}

interface Props {
  heading: TocItem;
  /** 1-based section number; only set for the top level of the tree. */
  number?: number;
  /** Depth relative to the tree root; drives indentation and the guides. */
  level?: number;
}

const {
  heading: { depth, slug, text: rawText, subheadings },
  number,
  level = 0,
} = Astro.props;
const text = rawText.endsWith("#") ? rawText.slice(0, -1) : rawText;
const hasSubheadings = subheadings.length > 0;
---

<li
  class="toc-node"
  data-depth={depth}
  style={`--toc-indent: ${level * 1.5}rem;`}
  data-collapsed={hasSubheadings ? "false" : undefined}
>
  <div class="relative">
    <span
      aria-hidden="true"
      class="toc-progress absolute w-[2px] rounded-full"
    ></span>
    {hasSubheadings ? (
      <button
        type="button"
        class:list={["toc-toggle", typeof number === "number" && "toc-badge"]}
        data-toc-toggle
        aria-expanded="true"
        aria-controls={`toc-children-${slug}`}
        aria-label={`切换章节：${text}`}
      >
        {typeof number === "number" && (
          <span aria-hidden="true" class="toc-toggle-number">
            {number}
          </span>
        )}
        <span aria-hidden="true" class="toc-toggle-glyph">
          <Icon name="material-symbols:chevron-right-rounded" size={18} />
        </span>
      </button>
    ) : (
      typeof number === "number" && (
        <span aria-hidden="true" class="toc-badge">
          {number}
        </span>
      )
    )}
    <a
      href={`#${slug}`}
      data-heading={slug}
      class="toc-link relative block text-sm text-muted-foreground"
      aria-label={`跳转到章节：${text}`}
    >
      {text}
    </a>
  </div>
  {hasSubheadings && (
      <ul class="toc-children" id={`toc-children-${slug}`}>
        {subheadings.map((subheading) => (
          <Astro.self heading={subheading} level={level + 1} />
        ))}
      </ul>
    )}
</li>
