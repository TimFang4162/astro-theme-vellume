---
import { render } from "astro:content";
import type { InferGetStaticPropsType } from "astro";
import PostList from "../../components/blog/PostList.astro";
import ProseContent from "../../components/ui/ProseContent.astro";
import SectionIntro from "../../components/ui/SectionIntro.astro";
import Layout from "../../layouts/BaseLayout.astro";
import {
  getPublicBlogPosts,
  getSeriesEntries,
  getSeriesMeta,
} from "../../lib/blog";

export async function getStaticPaths() {
  const publicPosts = await getPublicBlogPosts();
  const seriesEntries = await getSeriesEntries();

  // Serialize the precomputed series bundle only; passing `publicPosts` here
  // would inline every post body into every series page's props.
  return getSeriesMeta(seriesEntries, publicPosts).map((seriesItem) => ({
    params: { series: seriesItem.entry.id },
    props: { seriesItem },
  }));
}

export type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { seriesItem } = Astro.props;
const { entry: series, posts: seriesPosts } = seriesItem;
const { Content } = await render(series);
const pageTitle = `系列: ${series.data.title}`;
const pageDescription =
  series.data.description || `${series.data.title} 系列文章`;
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="page-stack">
    <SectionIntro
      title={pageTitle}
      description="按主题组织的系列文章"
      fontStyle="reading"
      backHref="/series"
      backLabel="返回系列页"
    />

    <div class="article-column">
      <ProseContent> <Content /> </ProseContent>
    </div>

    <PostList
      posts={seriesPosts}
      defaultView="card"
      description="这个系列中的全部文章"
      showViewToggle
      viewKey="series"
    />
  </div>
</Layout>
