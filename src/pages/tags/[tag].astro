---
import type { InferGetStaticPropsType } from "astro";
import PostList from "../../components/blog/PostList.astro";
import SectionIntro from "../../components/ui/SectionIntro.astro";
import Layout from "../../layouts/BaseLayout.astro";
import { getPublicBlogPosts, getTagCounts } from "../../lib/blog";

export async function getStaticPaths() {
  const allPosts = await getPublicBlogPosts();
  const tags = getTagCounts(allPosts);

  // Serialize only the posts belonging to each tag; passing `allPosts` here
  // would inline every post body into every tag page's props.
  return Array.from(tags.keys()).map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

export type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag, posts } = Astro.props;
const pageTitle = `标签: ${tag}`;
---

<Layout title={pageTitle}>
  <div class="page-stack">
    <SectionIntro
      title={pageTitle}
      description="按标签归档的相关文章"
      backHref="/tags"
      backLabel="返回标签页"
    />
    <PostList
      posts={posts}
      defaultView="card"
      description="这个标签下的全部文章"
      showViewToggle
      viewKey="tag"
    />
  </div>
</Layout>
