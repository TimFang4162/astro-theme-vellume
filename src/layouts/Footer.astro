---
import { siteConfig } from "../config/site";
import { footerNavItems } from "../site/navigation";
import { withBasePath } from "../utils/paths";

const year = new Date().getFullYear();
const sitemapHref = withBasePath("/sitemap-index.xml");
---

<footer class="mt-16 border-t border-border bg-surface">
  <div class="page-frame py-10 sm:py-12">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-[2fr_1fr_1fr]">
      <div class="flex h-full flex-col justify-between gap-4">
        <div>
          <span class="text-lg font-semibold tracking-tight text-strong">
            {siteConfig.site.title}
          </span>
          <p class="text-sm leading-relaxed text-muted-foreground">
            {siteConfig.author.tagline}
          </p>
        </div>
        <div class="text-sm leading-relaxed text-muted-foreground">
          <p>&copy; {year} {siteConfig.author.copyrightName}</p>
          <p set:html={siteConfig.site.attribution} />
        </div>
      </div>

      <nav aria-label="Footer navigation">
        <div
          class="mb-3 font-sans text-xs font-medium uppercase tracking-widest text-muted-foreground"
        >
          导航
        </div>
        <ul class="m-0 flex list-none flex-col p-0">
          {footerNavItems.map((item) => (
            <li>
              <a
                href={withBasePath(item.href)}
                class="text-sm text-muted-foreground transition-ui hover:text-primary"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <div
          class="mb-3 font-sans text-xs font-medium uppercase tracking-widest text-muted-foreground"
        >
          链接
        </div>
        <ul class="m-0 flex list-none flex-col p-0">
          <li>
            <a
              href={withBasePath(siteConfig.links.rss)}
              class="text-sm text-muted-foreground transition-ui hover:text-primary"
            >
              RSS
            </a>
          </li>
          <li>
            <a
              href={sitemapHref}
              class="text-sm text-muted-foreground transition-ui hover:text-primary"
            >
              Sitemap
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
